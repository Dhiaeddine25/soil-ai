if __name__ == "__main__":
    print("\n🚀 DÉBUT DE L'ENTRAÎNEMENT OPTIMISÉ POUR 90% (DenseNet201)")
    start_time = time.time()

    # Entraînement ou chargement
    thresholds, models = train_all_labels(train_df, valid_df)

    # Évaluation sur validation
    valid_hamming, _, _ = compute_hamming_accuracy(valid_df, models, thresholds, 'valid')
    print(f"\n📊 HAMMING ACCURACY SUR VALIDATION : {valid_hamming:.4f} ({valid_hamming*100:.2f}%)")

    # Évaluation sur test
    test_hamming, y_pred_binary, final_predictions = compute_hamming_accuracy(test_df, models, thresholds, 'test')
    print(f"\n🏆 HAMMING ACCURACY SUR TEST : {test_hamming:.4f} ({test_hamming*100:.2f}%)")

    # Sauvegarde des résultats
    y_true = test_df[labels].values
    results = {
        'hamming_accuracy': float(test_hamming),
        'hamming_accuracy_valid': float(valid_hamming),
        'thresholds': {label: float(thresholds[label]) for label in labels},
        'per_label_accuracy': {label: float(np.mean(y_true[:,i] == y_pred_binary[:,i])) for i, label in enumerate(labels)}
    }
    with open(os.path.join(SAVE_DIR, 'results.json'), 'w') as f:
        json.dump(results, f, indent=2)

    # Graphique récapitulatif
    plot_final_summary(results, SAVE_DIR, dataset='test')

    # Sauvegarde des prédictions
    pred_df = test_df[['filename']].copy()
    for i, lbl in enumerate(labels):
        pred_df[f'{lbl}_pred'] = y_pred_binary[:, i]
        pred_df[f'{lbl}_prob'] = final_predictions[:, i]
    pred_df.to_csv(os.path.join(SAVE_DIR, 'test_predictions.csv'), index=False)

    print(f"\n✅ Résultats sauvegardés dans {SAVE_DIR}")
    print(f"⏱️  Temps total : {(time.time()-start_time)/3600:.2f} heures")